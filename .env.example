# ============================================
# AgTradeGroup E-Commerce Platform
# Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# ============================================

# ----------------------------------------
# PostgreSQL Database
# ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_secure_password
POSTGRES_DB=agtradegroup

# ----------------------------------------
# Backend
# ----------------------------------------
NODE_ENV=production
BACKEND_PORT=3001

# JWT Secrets — Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_random_64_character_secret_key_here_1234567890abcdef
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_random_64_character_secret_key_1234567890ab
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------
# Email (SMTP) — Optional, for order confirmations
# ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@agtradegroup.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@agtradegroup.com

# ----------------------------------------
# URLs
# ----------------------------------------
BASE_URL=https://agtradegroup.com
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ----------------------------------------
# WhatsApp Contact
# ----------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=38344123456

# ----------------------------------------
# Shipping
# ----------------------------------------
FREE_DELIVERY_CITY=Ferizaj
STANDARD_DELIVERY_FEE=2
NEXT_PUBLIC_FREE_DELIVERY_CITY=Ferizaj
NEXT_PUBLIC_DELIVERY_FEE=2
NEXT_PUBLIC_CURRENCY=EUR

# ----------------------------------------
# File Uploads
# ----------------------------------------
MAX_UPLOAD_SIZE=5242880

# ----------------------------------------
# Social sign-in (optional — leave empty to hide buttons)
# Google: https://console.cloud.google.com/apis/credentials
# Facebook: https://developers.facebook.com/apps
# Apple: https://developer.apple.com/account/resources/identifiers/list/serviceId
# ----------------------------------------
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=http://localhost:3002/account/login
